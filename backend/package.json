{
  "name": "blood-donation-backend",
  "version": "1.0.0",
  "description": "Backend REST API for Blood Donation Application",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsc && node --watch dist/server.js",
    "build": "tsc",
    "start": "node dist/server.js",
    "test": "ts-node-dev --transpile-only src/tests/bloodCompatibility.test.ts && ts-node-dev --transpile-only src/tests/donorWorkflow.test.ts && ts-node-dev --transpile-only src/tests/pushNotifications.test.ts && ts-node-dev --transpile-only src/tests/communication.test.ts && ts-node-dev --transpile-only src/tests/comprehensiveWorkflow.test.ts",
    "test:workflow": "ts-node-dev --transpile-only src/tests/donorWorkflow.test.ts",
    "test:push": "ts-node-dev --transpile-only src/tests/pushNotifications.test.ts",
    "test:chat": "ts-node-dev --transpile-only src/tests/communication.test.ts",
    "test:e2e": "ts-node-dev --transpile-only src/tests/comprehensiveWorkflow.test.ts",
    "test:db": "ts-node-dev --transpile-only src/tests/testDatabaseConnection.ts"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.10.1",
    "morgan": "^1.10.0",
    "socket.io": "^4.8.3"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.8",
    "@types/morgan": "^1.9.9",
    "@types/node": "^22.13.4",
    "@types/socket.io": "^3.0.1",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.7.3"
  }
}
