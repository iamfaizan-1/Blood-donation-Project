# Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration
MONGODB_URI=mongodb://127.0.0.1:27017/blood_donation_db

# JWT Configuration
JWT_SECRET=super_secret_jwt_key_change_in_production_987654321
JWT_EXPIRES_IN=7d

# CORS Configuration
CLIENT_URL=http://localhost:8081

# Optional chatbot model provider. Leave the key blank to use offline FAQs.
# When configured, the endpoint receives the current question and recent chat turns.
CHATBOT_API_KEY=
CHATBOT_API_URL=https://api.openai.com/v1/chat/completions
CHATBOT_MODEL=gpt-4o-mini
